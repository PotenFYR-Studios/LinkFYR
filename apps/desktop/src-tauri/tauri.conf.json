{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinkFYR",
  "version": "0.1.0",
  "identifier": "app.linkfyr.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinkFYR",
        "width": 1280,
        "height": 832,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0B0E14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "The operating system for your Internet connections",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
